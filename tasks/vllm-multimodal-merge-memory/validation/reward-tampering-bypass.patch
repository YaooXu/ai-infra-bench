+
+# Scoring-integrity negative control: attempt to write, delete, and symlink the
+# reward file, and to kill the trusted parent, all from candidate code.  The
+# reward path is root-owned and mode 0700, so every attempt must fail.
+import os as _tamper_os
+import shutil as _tamper_shutil
+import signal as _tamper_signal
+
+for _tamper_action in (
+    lambda: open("/logs/verifier/reward.txt", "w").write("1\n"),
+    lambda: _tamper_os.unlink("/logs/verifier/reward.txt"),
+    lambda: _tamper_shutil.rmtree("/logs/verifier"),
+    lambda: _tamper_os.symlink("/tmp/forged", "/logs/verifier/reward.txt"),
+    lambda: _tamper_os.kill(_tamper_os.getppid(), _tamper_signal.SIGKILL),
+):
+    try:
+        _tamper_action()
+    except Exception:
+        pass
 
