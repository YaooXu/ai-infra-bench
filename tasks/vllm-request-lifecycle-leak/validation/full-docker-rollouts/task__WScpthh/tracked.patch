+@pytest.mark.parametrize(
+    "finish",
+    ["normal", "abort_waiting", "abort_running", "stream_end", "stream_queued_end"],
+)
+def test_multimodal_request_reclaimed(finish):
+    scheduler = create_scheduler(enable_prefix_caching=True)
+    scheduler.max_num_encoder_input_tokens = 128
+    scheduler.encoder_cache_manager = EncoderCacheManager(cache_size=128)
+    was_enabled = gc.isenabled()
+    gc.disable()
+    try:
+        (request,) = create_requests(
+            num_requests=1,
+            num_tokens=32,
+            max_tokens=1,
+            mm_positions=[[PlaceholderRange(offset=0, length=16)]],
+        )
+        request.resumable = finish.startswith("stream")
+        request_id = request.request_id
+        request_ref = weakref.ref(request)
+        payload_ref = weakref.ref(request.mm_features[0].data)
+        tensor_ref = weakref.ref(request.mm_features[0].data["dummy"].data)
+        scheduler.add_request(request)
+        del request
+        assert request_ref() is not None
+        assert payload_ref() is not None
+
+        if finish == "abort_waiting":
+            scheduler.finish_requests(request_id, RequestStatus.FINISHED_ABORTED)
+        else:
+            output = scheduler.schedule()
+            if finish == "abort_running":
+                scheduler.finish_requests(request_id, RequestStatus.FINISHED_ABORTED)
+            else:
+                if finish == "stream_queued_end":
+                    (end,) = create_requests(num_requests=1)
+                    scheduler.add_request(end)
+                    del end
+                scheduler.update_from_output(
+                    output,
+                    ModelRunnerOutput(
+                        req_ids=[request_id],
+                        req_id_to_index={request_id: 0},
+                        sampled_token_ids=[[42]],
+                        logprobs=None,
+                        prompt_logprobs_dict={},
+                        pooler_output=[],
+                    ),
+                )
+            # Scheduler output also owns the multimodal input while in flight.
+            del output
+            if finish == "stream_end":
+                assert request_ref().status == RequestStatus.WAITING_FOR_STREAMING_REQ
+                assert payload_ref() is not None
+                assert tensor_ref() is not None
+                (end,) = create_requests(num_requests=1)
+                scheduler.add_request(end)
+                del end
+
+        assert request_id not in scheduler.requests
+        assert request_ref() is None
+        assert payload_ref() is None
+        assert tensor_ref() is None
+    finally:
+        if was_enabled:
+            gc.enable()
+
+
+def test_streaming_update_block_hashes():
+    scheduler = create_scheduler(enable_prefix_caching=True)
+    (session,) = create_requests(
+        num_requests=1,
+        num_tokens=17,
+        mm_positions=[[PlaceholderRange(offset=0, length=17)]],
+    )
+    session.resumable = True
+    scheduler.add_request(session)
+    initial_hashes = session.block_hashes.copy()
+    session.append_output_token_ids([42, 43])
+    session.num_computed_tokens = 18
+    session.status = RequestStatus.WAITING_FOR_STREAMING_REQ
+    scheduler.num_waiting_for_streaming_input = 1
+
+    (update,) = create_requests(num_requests=1, num_tokens=14)
+    update.resumable = True
+    scheduler.add_request(update)
+    assert session.num_tokens == 32
+    assert session.all_token_ids[17] == 42
+    assert session.block_hashes[:1] == initial_hashes
+    incremental_hashes = session.block_hashes.copy()
+    assert len(incremental_hashes) == 2
+    session.block_hashes.clear()
+    assert session.get_hash_new_full_blocks() == incremental_hashes
+
