-from vllm.v1.request import RequestStatus
+import gc
+import weakref
+
+import pytest
+
+from vllm.multimodal.inputs import (
+    MultiModalFeatureSpec,
+    MultiModalKwargsItem,
+    PlaceholderRange,
+)
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher, init_none_hash
+from vllm.v1.request import Request, RequestStatus
+
+
+@pytest.mark.parametrize("enable_prefix_caching", [False, True])
+def test_request_hashing_and_reclamation(enable_prefix_caching):
+    init_none_hash(sha256)
+    hasher = get_request_block_hasher(4, sha256) if enable_prefix_caching else None
+    was_enabled = gc.isenabled()
+    gc.disable()
+    try:
+        request = Request(
+            request_id="multimodal",
+            prompt_token_ids=[1, 2, 3, 4, 5],
+            sampling_params=SamplingParams(max_tokens=16),
+            pooling_params=None,
+            eos_token_id=None,
+            mm_features=[
+                MultiModalFeatureSpec(
+                    data=MultiModalKwargsItem.dummy(),
+                    modality="image",
+                    identifier="image-hash",
+                    mm_position=PlaceholderRange(offset=0, length=5),
+                )
+            ],
+            block_hasher=hasher,
+        )
+        request_ref = weakref.ref(request)
+        payload_ref = weakref.ref(request.mm_features[0].data)
+        initial_hashes = request.block_hashes.copy()
+        assert len(initial_hashes) == (1 if enable_prefix_caching else 0)
+        request.append_output_token_ids(6)
+        assert request.block_hashes == initial_hashes
+        request.append_output_token_ids([7, 8, 9, 10, 11, 12])
+        incremental_hashes = request.block_hashes.copy()
+        assert len(incremental_hashes) == (3 if enable_prefix_caching else 0)
+        assert incremental_hashes[: len(initial_hashes)] == initial_hashes
+        assert request.get_hash_new_full_blocks() == []
+        request.block_hashes.clear()
+        assert request.get_hash_new_full_blocks() == incremental_hashes
+        assert payload_ref() is not None
+        del request
+        # Refcount release must suffice, without a cyclic GC pass.
+        assert request_ref() is None
+        assert payload_ref() is None
+    finally:
+        if was_enabled:
+            gc.enable()
 
 
