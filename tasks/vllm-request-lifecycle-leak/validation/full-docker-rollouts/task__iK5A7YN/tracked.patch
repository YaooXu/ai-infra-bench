+@pytest.mark.parametrize(
+    "ending", ["stop", "abort", "abort_running", "stream_end", "queued_end"]
+)
+def test_multimodal_request_lifecycle_without_cyclic_gc(ending):
+    scheduler = create_scheduler(enable_prefix_caching=True, block_size=4)
+    init_none_hash(sha256)
+    was_enabled = gc.isenabled()
+    gc.disable()
+    try:
+        request = make_mm_request()
+        request.resumable = ending in ("stream_end", "queued_end")
+        scheduler.add_request(request)
+        if ending == "abort_running":
+            scheduler.running.append(scheduler.waiting.pop_request())
+            request.status = RequestStatus.RUNNING
+        request_ref = weakref.ref(request)
+        payload_ref = weakref.ref(request.mm_features[0].data["dummy"].data)
+        del request
+        assert request_ref() is scheduler.requests["mm"]
+        assert payload_ref() is not None
+
+        if ending in ("abort", "abort_running"):
+            scheduler.finish_requests("mm", RequestStatus.FINISHED_ABORTED)
+        else:
+            request = scheduler.waiting.pop_request()
+            request.status = RequestStatus.FINISHED_STOPPED
+            if ending == "queued_end":
+                scheduler.add_request(DummyRequest("mm", resumable=False))
+            finished = scheduler._handle_stopped_request(request)
+            if finished:
+                scheduler._free_request(request)
+            del request
+            if ending == "stream_end":
+                assert not finished
+                assert request_ref().status == RequestStatus.WAITING_FOR_STREAMING_REQ
+                assert payload_ref() is not None
+                scheduler.add_request(DummyRequest("mm", resumable=False))
+            else:
+                assert finished
+
+        assert "mm" not in scheduler.requests
+        assert not scheduler.waiting
+        assert not scheduler.running
+        assert request_ref() is None
+        assert payload_ref() is None
+    finally:
+        if was_enabled:
+            gc.enable()
+
+
